{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd development && pnpm install",
  "buildCommand": "cd development && pnpm run build",
  "outputDirectory": "development/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://f-b-devp.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
