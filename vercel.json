{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && corepack prepare pnpm@9.15.4 --activate && pnpm --dir development install --frozen-lockfile",
  "buildCommand": "pnpm --dir development run build",
  "outputDirectory": "development/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://f-b-devp.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
