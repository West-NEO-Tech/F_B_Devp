# BizSim Server Configuration
# Copy this file to .env and fill in the values

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bizsim:bizsim_dev@localhost:5434/bizsim

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Application ─────────────────────────────────────────────────
LOG_LEVEL=DEBUG
APP_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── LLM Unified Entry Point ────────────────────────────────────
# All environments use the same code path — only env vars change.
#
# ┌─────────────┬──────────────────────────────────────────────────┐
# │ Environment │ Configuration                                    │
# ├─────────────┼──────────────────────────────────────────────────┤
# │ Local dev   │ LiteLLM Proxy → GitHub Copilot ($0)             │
# │             │   LLM_BASE_URL=http://localhost:4100/v1          │
# │             │   LLM_API_KEY=sk-anything                        │
# │             │   LLM_MODEL=gpt-4o-mini                          │
# ├─────────────┼──────────────────────────────────────────────────┤
# │ Production  │ OpenRouter                                       │
# │             │   LLM_BASE_URL=https://openrouter.ai/api/v1     │
# │             │   LLM_API_KEY=sk-or-v1-your-key-here            │
# │             │   LLM_MODEL=deepseek/deepseek-chat-v3-0324      │
# ├─────────────┼──────────────────────────────────────────────────┤
# │ CI / Tests  │ Not used — tests mock AsyncOpenAI                │
# └─────────────┴──────────────────────────────────────────────────┘
#
# To start LiteLLM proxy (GitHub Copilot, no API key needed):
#   ./server/scripts/start-litellm.sh
#
# First run: creates isolated venv (~30s) + shows OAuth device code.
# Credentials are cached locally after that.

LLM_BASE_URL=http://localhost:4100/v1
LLM_API_KEY=sk-anything
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7
