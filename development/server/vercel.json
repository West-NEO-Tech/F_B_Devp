{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python scripts/vercel_build.py",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.3.1",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
