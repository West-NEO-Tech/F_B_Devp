# 强制所有文本文件使用 LF 行尾
* text=auto eol=lf

# 明确指定文本文件类型
*.md        text eol=lf
*.html      text eol=lf
*.tsx       text eol=lf
*.ts        text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.env       text eol=lf
*.sql       text eol=lf

# 二进制文件不做处理
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
